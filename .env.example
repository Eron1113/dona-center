# ===== Supabase (https://supabase.com/dashboard/project/_/settings/api) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# IMPORTANT: Service role key bypasses RLS. Only use it in API routes (never client-side).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Cloudinary (https://cloudinary.com/console) — for admin photo uploads =====
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===== Admin (the email that can manage the store) =====
NEXT_PUBLIC_ADMIN_EMAIL=donacenter16@gmail.com
# Used by supabase/create-admin.js to create the store-owner account
ADMIN_PASSWORD=your-admin-password

# ===== Site (used by sitemap.xml / robots.txt) =====
# Defaults to https://donacenter.com if unset
NEXT_PUBLIC_SITE_URL=https://donacenter.com
